[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# Reuse the aliases shared with Bash.
if [ -f ~/.bash_aliases ]; then
  source ~/.bash_aliases
fi

# Override the Bash-specific reload alias.
alias reload='source ~/.zshrc'

# Enable colored output for macOS ls.
if [[ "$OSTYPE" == darwin* ]]; then
  alias ls='ls -G'
fi

# Match the Bash-style prompt: green user@host, blue working directory, then $.
PROMPT='%B%F{green}%n@%m%f%b:%B%F{blue}%~%f%b$ '
